DB_NAME=financial_journal
DB_USER=postgres
DB_PASSWORD=changeme

MONOBANK_TOKEN=
MONOBANK_ACCOUNT_ID=

# Must match the deployed frontend's exact origin (scheme + host), even though
# nginx proxies /api/ same-origin: browsers still send an Origin header on
# POST/PUT/PATCH/DELETE requests, and Spring's CORS check rejects any request
# carrying one that doesn't match this list with a 403 — "same-origin" alone
# does not exempt it.
CORS_ALLOWED_ORIGINS=https://your-server-ip-or-domain
